<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- The camera notch sits on a short edge in landscape; draw behind it and pad with insets. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
